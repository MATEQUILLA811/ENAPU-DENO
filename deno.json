{
  "name": "enapu-backend",
  "version": "1.0.0",
  "description": "Backend API del Sistema SIGEP-ENAPU - Deno + Oak",
  "compilerOptions": {
    "noImplicitAny": false
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "pg": "npm:pg@^8.13.1"
  }
}
